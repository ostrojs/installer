{
    "name": "@ostro/installer",
    "version": "2.0.0-alpha.6",
    "description": "Official CLI installer for the OstroJS framework",
    "main": "build/index.js",
    "types": "./build/types/index.d.ts",
    "bin": {
        "ostro": "build/index.js"
    },
    "files": [
        "build",
        "LICENSE.md",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./build/types/index.d.ts",
            "default": "./build/index.js"
        },
        "./*": {
            "types": "./build/types/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "dependencies": {
        "@ostro/console": "^2.0.0-alpha.2",
        "@ostro/support": "^2.0.0-alpha.2",
        "typescript": "^5.8.0"
    },
    "scripts": {
        "build": "npx tsc -p tsconfig.build.json && chmod +x build/index.js && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "preferGlobal": true,
    "keywords": [
        "ostro",
        "ostrojs",
        "framework",
        "installer",
        "cli",
        "scaffold",
        "generator"
    ],
    "author": "OstroJS Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ostrojs/installer.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/installer/issues"
    },
    "homepage": "https://github.com/ostrojs/installer#readme",
    "devDependencies": {
        "jest": "^30.5.2",
        "typescript": "^5.8.0",
        "@types/node": "^22.0.0",
        "@types/jest": "^30.0.0",
        "c8": "^10.1.3",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
