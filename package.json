{
    "name": "@ostro/installer",
    "version": "2.0.0-alpha.14",
    "description": "Official CLI installer for the OstroJS framework",
    "main": "index.js",
    "types": ".typed/index.d.ts",
    "bin": {
        "ostro": "index.js",
        "craft": "index.js"
    },
    "exports": {
        ".": {
            "types": "./.typed/index.d.ts",
            "default": "./index.js"
        },
        "./*": {
            "types": "./.typed/*.d.ts",
            "default": "./*.js"
        }
    },
    "dependencies": {
        "@ostro/console": "^2.0.0-alpha.3",
        "@ostro/support": "^2.0.0-alpha.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    },
    "scripts": {
        "build": "npm run lint:check && rm -rf build && ostro-build --prepare",
        "prepublishOnly": "npm run build",
        "test": "jest",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "engineStrict": true,
    "preferGlobal": true,
    "keywords": [
        "ostro",
        "ostrojs",
        "framework",
        "installer",
        "cli",
        "scaffold",
        "generator"
    ],
    "author": "OstroJS Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ostrojs/installer.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/installer/issues"
    },
    "homepage": "https://github.com/ostrojs/installer#readme",
    "devDependencies": {
        "@ostro/builder": "^2.0.0-alpha.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    }
}
